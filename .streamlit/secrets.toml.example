# Copy this to .streamlit/secrets.toml locally (never commit secrets.toml to GitHub).
# On Streamlit Community Cloud, paste these keys under App Settings -> Secrets.

GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"
GEMINI_CHAT_MODEL = "gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL = "models/gemini-embedding-001"
